  "grammar": [
    { "id": "grammar-ta-form", "slug": "ta-form", "title": "た form", "jlptLevel": "N4", "category": "grammar", "subcategory": "verb forms", "difficulty": 3, "prerequisiteIds": ["grammar-dictionary-form", "grammar-te-form"], "tags": ["verb", "past", "plain-form"], "pattern": "Vた", "meaning": "plain past; did V", "formation": "Change the final sound using the same pattern family as て-form, then use た or だ: 見る → 見た, 読む → 読んだ.", "intuition": "た closes a plain statement about an action that is already finished.", "usageConditions": ["Use it in casual statements and before grammar that needs a plain past clause.", "Use だ after the same verb groups that take で in the て-form."], "examples": [{ "japanese": "昨日、映画を見た。", "translation": "I watched a movie yesterday." }, { "japanese": "本を読んだあとで、寝ました。", "translation": "After reading a book, I went to sleep." }], "commonMistakes": ["Do not use the polite ending ました inside a plain-past pattern.", "Learn the た-form with its て-form family: 読んで → 読んだ, 見て → 見た."], "contrastIds": ["contrast-ta-masu", "contrast-mae-ato"], "practiceQuestionIds": ["grammar-ta-form-meaning", "grammar-ta-form-completion", "grammar-ta-form-order"] },
    { "id": "grammar-mae-ni", "slug": "mae-ni", "title": "前に", "jlptLevel": "N4", "category": "grammar", "subcategory": "sequence", "difficulty": 3, "prerequisiteIds": ["grammar-dictionary-form"], "tags": ["sequence", "time", "routine"], "pattern": "Vる前に", "meaning": "before doing V", "formation": "Dictionary-form verb + 前に; noun + の前に", "intuition": "前に puts one action before a later action on the timeline.", "usageConditions": ["Use the dictionary form before 前に for an action that has not happened yet.", "Use の after a noun: 学校の前に."], "examples": [{ "japanese": "寝る前に、本を読みます。", "translation": "Before going to bed, I read a book." }, { "japanese": "学校へ行く前に、朝ご飯を食べます。", "translation": "Before going to school, I eat breakfast." }], "commonMistakes": ["Use the dictionary form before 前に, not the polite ます form.", "Do not confuse Vる前に with Vたあとで; they describe opposite points in a sequence."], "contrastIds": ["contrast-mae-ato"], "practiceQuestionIds": ["grammar-mae-ni-meaning", "grammar-mae-ni-completion", "grammar-mae-ni-order"] },
    { "id": "grammar-ato-de", "slug": "ato-de", "title": "あとで", "jlptLevel": "N4", "category": "grammar", "subcategory": "sequence", "difficulty": 3, "prerequisiteIds": ["grammar-ta-form"], "tags": ["sequence", "time", "routine"], "pattern": "Vたあとで", "meaning": "after doing V; later", "formation": "Plain past verb + あとで; noun + のあとで", "intuition": "あとで starts with a finished action and then points to what follows it.", "usageConditions": ["Use the plain past form before あとで for a completed action.", "Use の after a noun: 買い物のあとで."], "examples": [{ "japanese": "ご飯を食べたあとで、勉強します。", "translation": "After eating, I study." }, { "japanese": "映画を見たあとで、友達と話します。", "translation": "After watching a movie, I talk with a friend." }], "commonMistakes": ["Use た-form before あとで, not dictionary form.", "The action before あとで happens first, even when the sentence begins with it."], "contrastIds": ["contrast-mae-ato"], "practiceQuestionIds": ["grammar-ato-de-meaning", "grammar-ato-de-completion", "grammar-ato-de-order"] },
    { "id": "grammar-toki", "slug": "toki", "title": "とき", "jlptLevel": "N4", "category": "grammar", "subcategory": "time and conditions", "difficulty": 3, "prerequisiteIds": ["grammar-dictionary-form", "grammar-i-adjective"], "tags": ["time", "conditions", "routine"], "pattern": "Vとき / Aとき", "meaning": "when; at the time that", "formation": "Plain form + とき; noun + のとき", "intuition": "とき frames the time or situation in which the main action happens.", "usageConditions": ["Use a plain verb, adjective, or noun phrase before とき.", "Use the present form for a situation that is upcoming or general, and past form for a situation already completed."], "examples": [{ "japanese": "寒いときは、家にいます。", "translation": "When it is cold, I stay home." }, { "japanese": "日本へ行ったとき、写真を撮りました。", "translation": "When I went to Japan, I took photos." }], "commonMistakes": ["Do not force every とき clause into the past; match it to the time you mean.", "Use のとき after a noun, not a bare noun directly before とき."], "contrastIds": ["contrast-toki-nagara"], "practiceQuestionIds": ["grammar-toki-meaning", "grammar-toki-completion", "grammar-toki-order"] },
    { "id": "grammar-nagara", "slug": "nagara", "title": "ながら", "jlptLevel": "N4", "category": "grammar", "subcategory": "connecting actions", "difficulty": 3, "prerequisiteIds": ["grammar-masu", "grammar-te-form"], "tags": ["simultaneous", "routine", "hobbies"], "pattern": "Vながら", "meaning": "while doing V", "formation": "Verb stem + ながら; the second action is the main action.", "intuition": "ながら keeps two actions in the same scene, with the second action as the focus.", "usageConditions": ["Use the verb stem before ながら: 聞きながら, not 聞くながら.", "The same person normally does both actions."], "examples": [{ "japanese": "音楽を聞きながら、勉強します。", "translation": "I study while listening to music." }, { "japanese": "歩きながら、友達と話します。", "translation": "I talk with a friend while walking." }], "commonMistakes": ["Remove ます from the polite form before adding ながら.", "The action after ながら is usually the main action you want to describe."], "contrastIds": ["contrast-toki-nagara"], "practiceQuestionIds": ["grammar-nagara-meaning", "grammar-nagara-completion", "grammar-nagara-order"] }
  ],
  "grammarContrasts": [
    { "id": "contrast-ta-masu", "title": "た form and ます form", "grammarPointIds": ["grammar-ta-form", "grammar-masu"], "explanation": "The ます form is polite and non-past. The plain た form describes a finished action and can connect to later grammar.", "examples": [{ "japanese": "映画を見ます。", "translation": "I watch a movie. (polite)" }, { "japanese": "映画を見た。", "translation": "I watched a movie. (plain past)" }], "exercises": ["Choose the polite form for a conversation with a teacher.", "Use the plain past form before あとで."] },
    { "id": "contrast-mae-ato", "title": "前に and あとで", "grammarPointIds": ["grammar-mae-ni", "grammar-ato-de"], "explanation": "前に places an action before a reference action. あとで places an action after a completed action.", "examples": [{ "japanese": "寝る前に、本を読みます。", "translation": "I read a book before sleeping." }, { "japanese": "本を読んだあとで、寝ます。", "translation": "After reading a book, I sleep." }], "exercises": ["Put a routine before bedtime with 前に.", "Describe what happens after dinner with あとで."] },
    { "id": "contrast-toki-nagara", "title": "とき and ながら", "grammarPointIds": ["grammar-toki", "grammar-nagara"], "explanation": "とき frames when a situation happens. ながら joins two actions happening at the same time, with the later action as the main focus.", "examples": [{ "japanese": "寒いときは、家にいます。", "translation": "When it is cold, I stay home." }, { "japanese": "音楽を聞きながら、勉強します。", "translation": "I study while listening to music." }], "exercises": ["Frame a weather-based routine with とき.", "Join two simultaneous actions with ながら."] }
  ],
  "readings": [
    { "id": "reading-school-and-health", "slug": "school-and-health", "title": "学校のあとで", "jlptLevel": "N4", "category": "reading", "subcategory": "short narrative", "difficulty": 4, "prerequisiteIds": ["grammar-ta-form", "grammar-ato-de"], "tags": ["school", "health", "routine", "sequence"], "passage": "今日は学校へ行きました。教室で宿題をして、先生に質問しました。宿題をしたあとで、頭が痛くなりました。午後、病院へ行きました。医者の話を聞いて、家で薬を飲みました。体を休めました。", "translation": "Today I went to school. I did homework in the classroom and asked the teacher a question. After doing my homework, my head started to hurt. In the afternoon, I went to the hospital. I listened to the doctor, took medicine at home, and rested my body.", "vocabularyIds": ["vocab-kyou", "vocab-gakko", "vocab-kyoushitsu", "vocab-shukudai", "vocab-sensei", "vocab-shitsumon", "vocab-kotae", "vocab-kiku", "vocab-atama", "vocab-itai", "vocab-gogo", "vocab-byouin", "vocab-isha", "vocab-kusuri", "vocab-nomu", "vocab-karada", "vocab-yasumu"], "grammarIds": ["grammar-wa", "grammar-te-form", "grammar-ta-form", "grammar-ato-de", "grammar-i-adjective-past", "grammar-masu"], "kanjiIds": ["kanji-gaku", "kanji-kyou", "kanji-shitsu", "kanji-shuku", "kanji-shitsumon", "kanji-mon", "kanji-kotae", "kanji-atama", "kanji-byou", "kanji-byoin", "kanji-i", "kanji-kusuri", "kanji-tai"], "estimatedDifficulty": 4, "questions": [{ "prompt": "どこで宿題をしましたか。", "options": ["病院", "教室", "家", "駅"], "correctAnswer": 1, "questionType": "short passage detail", "explanation": "教室で宿題をしました。" }, { "prompt": "宿題をしたあとで、どうなりましたか。", "options": ["映画を見ました", "頭が痛くなりました", "駅へ行きました", "薬を買いました"], "correctAnswer": 1, "questionType": "sequence", "explanation": "宿題をしたあとで、頭が痛くなりました。" }, { "prompt": "家で何をしましたか。", "options": ["宿題をしました", "先生に質問しました", "薬を飲んで体を休めました", "映画を見ました"], "correctAnswer": 2, "questionType": "information retrieval", "explanation": "家で薬を飲みました。体を休めました。" }] },
    { "id": "reading-seasons-and-plans", "slug": "seasons-and-plans", "title": "一年の予定", "jlptLevel": "N4", "category": "reading", "subcategory": "mid-length narrative", "difficulty": 4, "prerequisiteIds": ["grammar-ato-de", "grammar-toki", "grammar-nagara"], "tags": ["seasons", "weather", "hobbies", "plans"], "passage": "去年の春は晴れでした。夏は暑いです。家で音楽を聞いたあとで、映画を見ました。今年の秋は、音楽を聞きながら日本語を勉強する予定です。冬は雪が好きですが、寒いときは家にいます。来月の予定はまだ分かりません。", "translation": "Last spring was sunny. Summer is hot. At home, after listening to music, I watched a movie. This autumn, I plan to study Japanese while listening to music. I like snow in winter, but when it is cold, I stay home. I do not know next month's plans yet.", "vocabularyIds": ["vocab-kyonen", "vocab-haru", "vocab-hare", "vocab-natsu", "vocab-atsui", "vocab-ie", "vocab-ongaku", "vocab-kiku", "vocab-eiga", "vocab-miru", "vocab-kotoshi", "vocab-aki", "vocab-benkyou", "vocab-yotei", "vocab-fuyu", "vocab-yuki", "vocab-samui", "vocab-raigetsu", "vocab-wakaru"], "grammarIds": ["grammar-ta-form", "grammar-ato-de", "grammar-toki", "grammar-nagara", "grammar-tai", "grammar-masu"], "kanjiIds": ["kanji-kyou", "kanji-haru", "kanji-hare", "kanji-natsu", "kanji-on", "kanji-raku", "kanji-ei", "kanji-ga", "kanji-aki", "kanji-fuyu", "kanji-yuki"], "estimatedDifficulty": 4, "questions": [{ "prompt": "去年の春の天気はどうでしたか。", "options": ["晴れ", "雪", "曇り", "雨"], "correctAnswer": 0, "questionType": "short passage detail", "explanation": "去年の春は晴れでした。" }, { "prompt": "音楽を聞いたあとで、何をしましたか。", "options": ["勉強しました", "映画を見ました", "駅へ行きました", "薬を飲みました"], "correctAnswer": 1, "questionType": "sequence", "explanation": "音楽を聞いたあとで、映画を見ました。" }, { "prompt": "今年の秋の予定は何ですか。", "options": ["家で休むこと", "映画を見ること", "音楽を聞きながら日本語を勉強すること", "病院へ行くこと"], "correctAnswer": 2, "questionType": "information retrieval", "explanation": "今年の秋は、音楽を聞きながら日本語を勉強する予定です。" }, { "prompt": "寒いとき、どうしますか。", "options": ["外を歩きます", "映画館へ行きます", "家にいます", "学校へ行きます"], "correctAnswer": 2, "questionType": "condition detail", "explanation": "寒いときは家にいます。" }] }
