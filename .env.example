NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only; required for private book storage redirects. Never expose this as NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Existing deployments may use SUPABASE_SERVICE_KEY instead.
# Optional private Storage bucket name; defaults to books.
# SUPABASE_BOOKS_BUCKET=books
# Optional private Studio feature; keep this server-side and never use it as a public client variable.
# OPENROUTER_API_KEY=your-openrouter-key
# Try free models in order if one is unavailable or rate-limited.
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free,xiaomi/mimo-v2-flash:free,tencent/hy3:free,minimax/minimax-m3:free
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Authenticated sync is opt-in and requires the 0014_sync_metadata.sql migration.
# Existing single-email setting remains supported.
# ALLOWED_EMAIL=you@example.com
# Optional additional allowlisted accounts; commas, semicolons, and newlines are supported.
# ALLOWED_EMAILS=aniruddh302004@gmail.com
# Admin-only Content Studio and AI generation. Set this to the owner's email
# or use ADMIN_USER_ID for an exact Supabase Auth UUID match.
# Admin email. The deployed admin is matched case-insensitively by this exact email.
# ADMIN_EMAIL=aj05767625@gmail.com
# Optional Auth user ID override; set this when you prefer UUID-based admin matching.
# ADMIN_USER_ID=your-admin-auth-uuid
